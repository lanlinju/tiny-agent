OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=
OPENAI_TEMPERATURE=
# DeepSeek example (OpenAI-compatible):
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# OPENAI_REASONING_MODEL=deepseek-reasoner
AGENT_ID=agent-1
AGENT_OWNER=local
AGENT_PORT=3987
AGENT_SESSION_DIR=sessions
AGENT_WORKSPACE_DIR=.
AGENT_WEB_DIR=dist/clients/web
AGENT_PLUGIN_DIR=plugins
AGENT_PLUGINS_ENABLED=true
# Comma-separated plugin names (empty = no restriction).
AGENT_PLUGINS_ALLOW=
AGENT_PLUGINS_DENY=
# CLI transcript file (optional). Empty disables it; `--log <path>` overrides.
AGENT_LOG_FILE=
AGENT_MAX_STEPS=8
# Optional JSON config file (defaults to ./agent.config.json if present).
# AGENT_CONFIG=
